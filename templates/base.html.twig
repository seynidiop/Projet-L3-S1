<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gestion Employés{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Header avec barre de navigation #}
    <header class="header">
        <div class="container">
            <div class="header-content">
                <a href="/" class="logo">
                    <h3>BRASIL BURGER</h3>
                </a>
                
                <nav class="nav">
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') == 'app_commande_list' ? 'active' : '' }}" href="{{path('app_commande_list')}}">
                                Commandes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}" href="{{path('app_dashboard')}}">
                                Tableau de bord
                            </a>
                        </li>
                        
                    </ul>
                </nav>

                <div class="user-menu">
                    <button class="user-toggle" id="userToggle">
                        <span class="user-icon">👤</span>
                        <span class="user-name">{{ app.user ? app.user.nomComplet : 'User' }}</span>
                        <span class="dropdown-arrow">▼</span>
                    </button>
                    <div class="dropdown-menu" id="dropdownMenu">
                        <div class="dropdown-item role">{{ app.user ? app.user.roles[0] : '' }}</div>
                        <a href="#" class="dropdown-item">Paramètres</a>
                        <div class="dropdown-divider"></div>
                        {% if app.user %}
                            <a href="{{ path('app_logout') }}" class="dropdown-item">Déconnexion</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </header>

    {# Contenu principal #}
    <main class="main-content">
        {% block body %}{% endblock %}
    </main>

    {% block javascripts %}
    <script>
        // Toggle dropdown menu
        const userToggle = document.getElementById('userToggle');
        const dropdownMenu = document.getElementById('dropdownMenu');
        
        if (userToggle && dropdownMenu) {
            userToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                dropdownMenu.classList.toggle('show');
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', () => {
                dropdownMenu.classList.remove('show');
            });
        }
    </script>
    {% endblock %}
</body>
</html>

