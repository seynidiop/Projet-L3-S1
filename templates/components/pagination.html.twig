{% if totalPages > 1 %}
<div class="custom-pagination">
    <div class="pagination-info">
        Page {{ currentPage }} sur {{ totalPages }}
    </div>
    
    <div class="pagination-buttons">
        {# Bouton Précédent #}
        
        {% if currentPage > 1 %}
            <a href="{{ path(pathName, app.request.query.all|merge({page: currentPage - 1})) }}" class="pagination-btn pagination-prev">
                ← Précédent
            </a>
        {% else %}
            <span class="pagination-btn pagination-prev disabled">
                ← Précédent
            </span>
        {% endif %}
        
        {# Boutons de pages #}
        <div class="pagination-numbers">
            {% for page in 1..totalPages %}
                <a href="{{ path(pathName, app.request.query.all|merge({page: page})) }}"
                   class="pagination-number {{ page == currentPage ? 'active' : '' }}">
                    {{ page }}
                </a>
            {% endfor %}
        </div>
        
        {# Bouton Suivant #}
        {% if currentPage < totalPages %}
            <a href="{{ path(pathName, app.request.query.all|merge({page: currentPage + 1})) }}" class="pagination-btn pagination-next">
                Suivant →
            </a>
        {% else %}
            <span class="pagination-btn pagination-next disabled">
                Suivant →
            </span>
        {% endif %}
    </div>
</div>
{% endif %}
